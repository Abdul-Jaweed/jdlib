# Every variable the enterprise example reads, with its marking. No value is real: this file
# documents *names*, and a deployment supplies values from its own secret store.
#
# Markings, per the directive: required | optional, and secret | non-secret.

# -- The library's own contract (JDLIB_*). The library reads these itself; the example only
#    documents them. Design authority: docs/jdlib/configuration.md (once it exists), and the
#    pydantic models in jdlib.config.
JDLIB_CONTROL_DSN=                  # required, SECRET -- carries a database password
JDLIB_CONTEXT__SIGNING_KEY=         # required, SECRET -- at least 32 bytes, hex
JDLIB_OIDC__ISSUER=                 # required when OIDC is enabled, non-secret
JDLIB_OIDC__AUDIENCE=               # required when OIDC is enabled, non-secret
JDLIB_OIDC__JWKS_URL=               # optional, non-secret -- defaults to <issuer>/.well-known/jwks.json
JDLIB_OIDC__ALGORITHMS=             # optional, non-secret -- defaults to ["RS256"]
JDLIB_OIDC__EMAIL_TRUSTED=          # optional, non-secret -- defaults to false
JDLIB_RESOLVERS__ORDER=             # optional, non-secret -- the tenant resolution order
JDLIB_RESOLVERS__HEADER_NAME=       # optional, non-secret -- defaults to X-Tenant-Slug

# -- The example's own settings (JDLIB_EXAMPLE_*). See app/configuration/settings.py.
JDLIB_EXAMPLE_CERBOS_ENDPOINT=      # required, non-secret -- https, or localhost in development
JDLIB_EXAMPLE_CERBOS_TIMEOUT_SECONDS=   # optional, non-secret -- defaults to 2
JDLIB_EXAMPLE_SERVICE_NAME=         # optional, non-secret -- the name spans and logs carry
JDLIB_EXAMPLE_OTEL_ENDPOINT=        # optional, non-secret -- empty means "do not trace"
JDLIB_EXAMPLE_GRAPH_URI=             # optional, non-secret -- bolt://127.0.0.1:7688 in the lab;
                                    #   empty means "this process projects nothing"
JDLIB_EXAMPLE_GRAPH_DATABASE=        # optional, non-secret -- defaults to neo4j
JDLIB_EXAMPLE_GRAPH_USERNAME=        # optional, non-secret -- defaults to neo4j
JDLIB_ENTERPRISE_GRAPH_PASSWORD=    # optional, SECRET -- the same variable the lab's compose file
                                    #   initialises the server with; the application resolves it
                                    #   through the credential provider (handle `graph-password`)
                                    #   and requires it when a graph URI is configured
JDLIB_EXAMPLE_MIGRATION_DSN=        # optional, SECRET -- the OWNER role's DSN: migrations,
                                    #   provisioning and policy installation. Required by the
                                    #   operator step (app/bootstrap.py) and by nothing else: the
                                    #   request path must not hold the credentials that can drop
                                    #   its own policies. See the README's "two roles".
